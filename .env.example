# Optional. If set, the dashboard asks for this PIN before showing anything.
DASHBOARD_PIN=

# Shared secret for ChatGPT / Cursor / Grok task API and MCP
# Header: x-control-centre-key
CONTROL_CENTRE_API_KEY=

# xAI API key for in-dashboard Grok chat. https://console.x.ai
XAI_API_KEY=
GROK_MODEL=grok-4-1-fast

# Shared secret for Cursor / Grok Bot ingest webhook (Authorization: Bearer …)
INGEST_SECRET=

# Optional GitHub token — higher rate limit if scoped.
GITHUB_TOKEN=
GITHUB_USERNAME=ryangibsonuk
