# Optional. If set, the dashboard asks for this PIN before showing anything.
DASHBOARD_PIN=

# Shared secret for ChatGPT / Cursor / Grok task API and MCP
# Header: x-control-centre-key
CONTROL_CENTRE_API_KEY=

# Published ChatGPT Control Centre origin (no trailing slash), for push/pull.
# Example: https://your-app.openai.site
CHATGPT_APP_URL=
# Key the ChatGPT app expects on x-control-centre-key. Defaults to CONTROL_CENTRE_API_KEY.
CHATGPT_APP_KEY=

# Google OAuth (Gmail + Drive + Sheets). Desktop app or Web client.
# Redirect: {origin}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# xAI API key for in-dashboard Grok chat. https://console.x.ai
XAI_API_KEY=
GROK_MODEL=grok-4-1-fast

# Shared secret for Cursor / Grok Bot ingest webhook (Authorization: Bearer …)
INGEST_SECRET=

# Optional GitHub token — higher rate limit if scoped.
GITHUB_TOKEN=
GITHUB_USERNAME=ryangibsonuk
